    <!-- ======= Contact Section ======= -->
    <hr>
    <section id="contato" class="d-flex py-5 min-vh-100 flex-column justify-content-center">
      <div class="container">
        <h2 class="text-center py-4  text-primary-color text-uppercase">
          Possui alguma dúvida? </h2>

        <div class="row d-flex justify-content-center align-items-center">
          <div class="col-sm-12 col-md-6 col-lg-6 d-flex flex-column justify-content-center">
            <p>
              Hey! E Se rolar aquele interesse em pedir um orçamento, manda bala no E-mail ou no WhatsApp. Respondo em
              aproximadamente
            </p>
            <p>
              48h por e-mail e em 5 horas pelo WhatsApp!
            </p>
            <p>
              E aí!! Vamos elaborar sua próxima tattoo? 🙌🏼
            </p>


          </div>
          <div class="col-sm-12 col-md-6 col-lg-6">
            <form id="submit" action="#">
              <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12">
                  <div class="form-floating mb-3">
                    <input type="text" name="name" class="form-control" id="nome" placeholder="Insira seu nome"
                      required="">
                    <label class="color1" for="nome">Nome</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12 col-md-6 col-lg-6">
                  <div class="form-floating mb-3">
                    <input type="email" name="email" class="form-control" id="email" placeholder="name@example.com"
                      required="">
                    <label class="color1" for="email">E-mail</label>
                  </div>
                </div>
                <div class="col-sm-12 col-md-6 col-lg-6">
                  <div class="form-floating mb-3">
                    <input type="tel" name="phone" class="form-control" id="tel" placeholder="Insira seu telefone"
                      required="">
                    <label class="color1" for="tel">Telefone</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12">
                  <div class="form-floating mb-3">
                    <input type="text" name="subject" class="form-control" id="subject" placeholder="Insira seu nome"
                      required="">
                    <label class="color1" for="subject">Assunto</label>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-12 col-md-12 col-lg-12">
                  <div class="form-floating mb-3">
                    <textarea name="message" class="form-control" placeholder="Deixe a sua mensagem" id="msg"
                      style="height: 100px" required=""></textarea>
                    <label class="color1" for="msg">Mensagem</label>
                  </div>
                </div>
              </div>
              <div class="grid text-center">
                <div class="stify-content-center ">
                  <div class="col-lg-4 mx-auto">
                    <div class="form-buttons">
                      <div class="d-grid gap-2">
                        <input type="submit" class="btn btn-primary" value=" Enviar ">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
